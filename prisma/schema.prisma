// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  address   String?
  invoices  Invoice[]
}

model Invoice {
  id          Int           @id @default(autoincrement())
  invoiceNo   String        @unique
  status      String        @default("DRAFT") // DRAFT, PENDING, PAID
  issueDate   DateTime      @default(now())
  dueDate     DateTime
  clientId    Int
  client      Client        @relation(fields: [clientId], references: [id])
  items       InvoiceItem[]
  totalAmount Float
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  description String
  quantity    Int
  rate        Float
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}
